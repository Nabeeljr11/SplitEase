{
  "name": "splitease-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SplitEase - Expense & Debt Splitting Tracker",
  "scripts": {
    "db:init": "powershell -ExecutionPolicy Bypass -File ./scripts/init-db.ps1",
    "db:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-db.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-db.ps1",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "seed": "npm run seed --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
